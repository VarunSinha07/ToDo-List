<!DOCTYPE html>
<html lang="en" dir="ltr">

<head>
  <meta charset="utf-8">
  <title>To Do List - Register</title>
  <link rel="stylesheet" href="css/styles.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">

  <script>
    function validatePassword() {
      var password = document.getElementById("exampleInputPassword1").value;
      var confirmPassword = document.getElementById("confirmPassword").value;

      // Regular expression to check if password contains at least one letter, one number, and one special character
      var passwordPattern = /^(?=.*[a-zA-Z])(?=.*[0-9])(?=.*[\W_]).{8,}$/;

      if (!passwordPattern.test(password)) {
        document.getElementById("passwordError").innerHTML = "Password must be at least 8 characters long, and contain letters, numbers, and a special character.";
        return false;  // Prevent form submission if password doesn't match the pattern
      } else if (password !== confirmPassword) {
        document.getElementById("passwordError").innerHTML = "Passwords do not match!";
        return false;  // Prevent form submission if passwords don't match
      } else {
        document.getElementById("passwordError").innerHTML = "";
        return true;  // Allow form submission
      }
    }
  </script>
</head>

<body class="bodyStyle">
  <div class="container-fluid">
    <form action="/register" method="post" class="mx-auto formStyle" onsubmit="return validatePassword()">
      <h4 class="text-center">Register</h4>

      <div class="mb-3 mt-5">
        <label for="email" class="form-label">Email</label>
        <input type="email" class="form-control" id="exampleInputEmail1" name="username" aria-describedby="emailHelp" required>
      </div>

      <div class="mb-3 mt-5">
        <label for="exampleInputPassword1" class="form-label">Password</label>
        <input type="password" class="form-control" id="exampleInputPassword1" name="password" required>
      </div>

      <div class="mb-3 mt-3">
        <label for="confirmPassword" class="form-label">Confirm Password</label>
        <input type="password" class="form-control" id="confirmPassword" required>
        <small id="passwordError" class="text-danger"></small> <!-- Error message -->
      </div>

      <button type="submit" class="btn btn-primary mt-4">Register</button>
      <a href="/" class="d-block mt-3">Already have an Account?</a>
    </form>
  </div>

  <footer class="text-center mt-5">
    Copyright Varun Sinha :)
  </footer>
</body>

</html>
